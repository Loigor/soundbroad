    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "@types/uuid": "^9.0.7",
    "node-pg-migrate": "^7.8.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
