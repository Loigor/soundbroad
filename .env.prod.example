# Backend API Base URL (internal Docker network)
PGHOST=db
PGPORT=5432
PGUSER=soundbroad
PGPASSWORD=soundbroad
PGDATABASE=soundbroad

# Node environment
NODE_ENV=production

# Server port
PORT=4000

# Storage path
FILE_STORAGE_PATH=/usr/src/app/storage

# CORS origins - update these for your production domain
CORS_ORIGIN=https://yourdomain.com
