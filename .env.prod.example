# Backend API Base URL (internal Docker network)
PGHOST=db
PGPORT=5432
PGUSER=soundbroad
PGPASSWORD=soundbroad
PGDATABASE=soundbroad

# Node environment
NODE_ENV=production

# Server port
PORT=4000

# Storage path
FILE_STORAGE_PATH=/usr/src/app/storage

# Notes:
# - CORS is handled by nginx reverse proxy (no CORS_ORIGIN needed)
# - For HTTPS, set up external reverse proxy in front of nginx port 80
# - Use strong, randomly generated passwords (min 32 chars)
# - Keep this file local (don't commit to git)
